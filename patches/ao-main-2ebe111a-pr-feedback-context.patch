+  function normalizeFeedbackBody(body: string): string {
+    return body.replace(/\s+/g, " ").trim();
+  }
+
+  function formatReviewLocation(path?: string, line?: number): string {
+    if (!path) return "general review";
+    return typeof line === "number" ? `${path}:${line}` : path;
+  }
+
+  function formatReviewBacklogMessage(comments: ReviewComment[]): string {
+    const countLabel =
+      comments.length === 1 ? "1 unresolved review comment" : `${comments.length} unresolved review comments`;
+    const lines = [
+      `There ${comments.length === 1 ? "is" : "are"} ${countLabel} on your PR. Address each one, push fixes, and reply in GitHub.`,
+      "",
+    ];
+
+    for (const comment of comments) {
+      lines.push(`- ${comment.author} on ${formatReviewLocation(comment.path, comment.line)}`);
+      lines.push(`  ${normalizeFeedbackBody(comment.body)}`);
+      lines.push(`  ${comment.url}`);
+    }
+
+    lines.push("", "After fixing, resolve or reply to the review threads on the PR.");
+    return lines.join("\n");
+  }
